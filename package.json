{
  "name": "comanda",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS multi-tenant para bares y cafes: POS, autopedido QR, inventario, finanzas, BI.",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @comanda/api test:e2e",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "db:migrate": "pnpm --filter @comanda/api db:migrate",
    "db:seed": "pnpm --filter @comanda/api db:seed",
    "db:reset": "pnpm --filter @comanda/api db:reset",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "argon2"
    ],
    "overrides": {
      "@nestjs/swagger>js-yaml": "5.4.2"
    }
  }
}
