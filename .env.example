# ---------------------------------------------------------------------------
# Comanda - variables de entorno
# Copiar a .env y ajustar. .env NO se versiona.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Base de datos -----------------------------------------------------------
# API runtime: rol comanda_app. No es owner y no tiene BYPASSRLS, asi que cada
# query queda sujeta a las politicas RLS.
DATABASE_URL=postgresql://comanda_app:comanda_app_dev@localhost:5432/comanda
# Migraciones: rol comanda_migrator (miembro de comanda_owner).
DATABASE_MIGRATIONS_URL=postgresql://comanda_migrator:comanda_migrator_dev@localhost:5432/comanda
# Solo para crear roles la primera vez (operativo).
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/comanda
POSTGRES_PORT=5432

# --- Redis (opcional en dev: cache, pub/sub, BullMQ) --------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- API ---------------------------------------------------------------------
API_PORT=3000
# Base publica de la API.
API_PUBLIC_URL=http://localhost:3000
# Origenes permitidos por CORS (separados por coma).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001

# Secretos de firma. OBLIGATORIOS en cualquier entorno != development.
# Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-cambiar-en-produccion-0000000000
JWT_ISSUER=comanda
JWT_AUDIENCE=comanda-api
# Vida corta a proposito: el refresh rotativo es la via de renovacion.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Pepper para el hash de PIN. Al ser el PIN de baja entropia (4-6 digitos), el
# hash va con argon2id Y pepper: sin el pepper, un dump de la DB permite un
# ataque por fuerza bruta trivial.
PIN_PEPPER=dev-only-pin-pepper-cambiar-en-produccion-00000000

# --- Cliente (Fase 3: menu QR, pagos) --------------------------------------
# Firma de los tokens QR de mesa. NUNCA en la base: rotar un QR es cambiar
# tables.qr_token_version y reimprimir, no cambiar el secreto.
# OBLIGATORIO en produccion (el default es solo de desarrollo).
QR_TOKEN_SECRET=dev-only-qr-token-secret-cambiar-en-produccion-000
# Secreto HMAC con el que el proveedor de pagos firma sus webhooks.
# Distinto del QR_TOKEN_SECRET: uno autentica al cliente (QR impreso),
# el otro autentica al proveedor (servidor a servidor).
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-cambiar-en-produccion-0

# Argon2id. memoryCost=64MB/timeCost=3 para password; el PIN usa mas effort
# porque el espacio de busqueda es mucho menor.
ARGON2_MEMORY_KB=65536
ARGON2_TIME_COST=3
ARGON2_PIN_MEMORY_KB=131072
ARGON2_PIN_TIME_COST=5

# --- Storage (S3-compatible) -------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/comanda
S3_REGION=us-east-1
S3_BUCKET=comanda
S3_ACCESS_KEY=comanda
S3_SECRET_KEY=comanda_dev_secret
S3_FORCE_PATH_STYLE=true

# --- Frontends ---------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
POS_PORT=5173
ADMIN_PORT=5174
STOREFRONT_PORT=3001

# --- Seeds -------------------------------------------------------------------
# Contrasena de los usuarios con acceso web en los datos de demo.
SEED_OWNER_PASSWORD=Comanda1234!