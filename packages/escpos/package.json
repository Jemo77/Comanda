{
  "name": "@comanda/escpos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generacion de tickets ESC/POS y drivers de impresion. Isomorfico: el POS lo corre en el navegador y la API en Node.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./drivers": "./src/drivers/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@comanda/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  }
}
